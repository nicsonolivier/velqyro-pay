# Copie para apps/api/.env e ajuste. Nunca coloque credenciais reais no repositório.

NODE_ENV=development
PORT=3333

# Banco local criado por "npm run db:up" (infrastructure/docker/docker-compose.yml).
DATABASE_URL=postgresql://velqyro:velqyro_dev@localhost:5432/velqyro_dev?schema=public

# Endereço do painel. Usado nos links enviados por e-mail e na checagem de origem das requisições.
APP_URL=http://localhost:5173
# Origens aceitas em requisições que alteram dados, separadas por vírgula.
WEB_ORIGINS=http://localhost:5173

# Sessão
SESSION_COOKIE_NAME=vq_session
SESSION_TTL_DAYS=7
# Em produção use true (exige HTTPS).
COOKIE_SECURE=false

# Chave de 32 bytes em base64 para cifrar segredos de 2FA.
# Gere a sua com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# A chave abaixo existe só para desenvolvimento e a API se recusa a subir com ela em produção.
APP_ENCRYPTION_KEY=ZGV2LW9ubHktbmFvLXVzYXItZW0tcHJvZHVjYW8hISE=

# Quantos proxies confiáveis existem na frente da API (0 em desenvolvimento).
TRUST_PROXY_HOPS=0
